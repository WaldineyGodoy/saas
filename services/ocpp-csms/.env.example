# Apenas nomes: valores reais so no ambiente de execucao (nunca no repositorio).
# Porta do servidor OCPP e do GET /health (padrao 9220)
PORT=
# basic = HTTP Basic por carregador (producao); off = sem autenticacao (so ambiente local)
OCPP_AUTH=
# Segundos ate cancelar uma recarga com RemoteStart aceito sem plug (padrao 120)
CONNECTION_TIMEOUT_S=
# Segundos de espera pela resposta de um comando enviado ao carregador (padrao 30)
CALL_TIMEOUT_S=
# Periodo, em segundos, do verificador de carregador offline por heartbeat (padrao 30)
OFFLINE_CHECK_S=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
